# This file registers the LibreSCRS agent-proxy PKCS#11 module with p11-kit.
# See man pkcs11.conf(5) and man p11-kit(8).
#
# DEFAULT (in-process): apps load librescrs-pkcs11-agent.so
# directly; it maps the PKCS#11 C_* ABI to D-Bus calls into the per-user
# librescrs-agent (the single card owner + prompter + policy + lease). The
# module itself holds NO card secret and does NO crypto. PIN/CAN are collected
# by the agent prompter (the token advertises CKF_PROTECTED_AUTHENTICATION_PATH),
# so they never reach the application — an app that passes a PIN to C_Login has
# it ignored.
#
# A RELATIVE module name is resolved against p11-kit's own module directory
# (pkg-config p11-kit-1 --variable p11_module_path), NOT against the prefix this
# build installed into. This build installs the library into
# @LIBRESCRS_P11_MODULE_DIR_ABS@, so the reference below is bare only when those
# two directories are the same — which is what lets a packager keep a 32/64-bit
# parallel install working, the same reason stock opensc.module is relative.
# Everywhere else it is absolute, because a dangling reference makes p11-kit
# drop the module silently: no warning, no entry, nothing to notice.
module: @LIBRESCRS_P11_MODULE_REF@

# Never abort other modules if this one fails to load (e.g. agent not running).
critical: no

# Sorted ahead of modules that declare no priority (pkcs11.conf(5): higher
# numbers first, default zero), so a search for keys and certificates finds
# the card through the agent before any generic module that might also see it.
priority: 10

# ---------------------------------------------------------------------------
# DISCOVERY WHERE p11-kit-proxy IS NOT WIRED INTO THE CONSUMER (no README per
# project policy — the notes live here):
#
#   NSS (Firefox/Thunderbird/Chrome) fallback registration:
#     modutil -dbdir sql:$HOME/.pki/nssdb -add librescrs \
#         -libfile @LIBRESCRS_P11_MODULE_DIR_ABS@/librescrs-pkcs11-agent.so
#     (or Settings -> Privacy & Security -> Security Devices -> Load.)
#
#   OpenSSH:
#     ssh -I @LIBRESCRS_P11_MODULE_DIR_ABS@/librescrs-pkcs11-agent.so user@host
#     (or PKCS11Provider in ~/.ssh/config.)
#
#   Standalone smoke / enumeration:
#     pkcs11-tool --module @LIBRESCRS_P11_MODULE_DIR_ABS@/librescrs-pkcs11-agent.so -T
#     p11-kit list-modules | grep -A5 librescrs
#   The token must list "protected authentication path".
#
#   PKCS#11 URI selection across all p11-kit modules (e.g. pkcs11:token=...,
#   or the p11-kit: scheme for module-scoped objects) works once this .module
#   is installed and the agent is running.
