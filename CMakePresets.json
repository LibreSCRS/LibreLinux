{
  "version": 4,
  "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "$env{HOME}/.local/librescrs"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Ninja)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "release-strict",
      "displayName": "Release + warnings as errors",
      "inherits": "release",
      "cacheVariables": { "LIBRELINUX_WERROR": "ON" }
    },
    {
      "name": "user",
      "displayName": "Per-user dogfood install ($HOME/.local, XDG units)",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "$env{HOME}/.local",
        "LIBRELINUX_USER_INSTALL": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "debug",   "jobs": 4 },
    { "name": "release", "configurePreset": "release", "jobs": 4 },
    { "name": "user",    "configurePreset": "user",    "jobs": 4 }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "environment": {
        "LD_LIBRARY_PATH": "$env{HOME}/.local/librescrs/lib"
      }
    }
  ]
}
