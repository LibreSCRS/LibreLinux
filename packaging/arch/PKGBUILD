# Maintainer: hirashix0 <hirashix0@proton.me>
#
# LibreLinux — Linux platform-native integration for the LibreSCRS stack.
# Split into two packages because the agent is DE-agnostic (and MUST stay
# Qt-free) while the KDE pinentry prompter pulls Qt6/KF6:
#
#   librescrs-agent        — headless, Qt-free D-Bus session service
#   librescrs-pinentry-kde — KDE-styled secure-input helper for the agent
#
# Dependency chain: librescrs-middleware <= librelinux <= librekde
#
# Versioning: this component no longer carries its own 0.x SemVer. It is
# released in lockstep with the rest of the stack, and pkgver is the first
# line of the repository's VERSION file — the same value the build stamps
# into the installed CMake version file, so a package labelled X.Y.Z cannot
# install a version file saying something else.

pkgbase=librelinux
pkgname=('librescrs-agent' 'librescrs-pinentry-kde')
pkgver=5.0.0
pkgrel=1
arch=('x86_64')
url="https://github.com/LibreSCRS/LibreLinux"
license=('LGPL-2.1-or-later')
makedepends=(
    'cmake'
    'ninja'
    'git'                       # GitVersion.cmake
    'pkgconf'
    'sdbus-cpp'                 # >=2.0 (agent + prompter D-Bus)
    'systemd-libs'              # libsystemd (event loop / sd_notify)
    'librescrs-middleware>=5.0' # LibreSCRS::* CMake config package
    'librescrs-agent-core'      # the agent core comes from a package, not a fetch
    'openssl'                   # agent: find_package(OpenSSL COMPONENTS Crypto)
    'pcsclite'
    'p11-kit'                   # pkcs11-module: p11-kit-1.pc resolves module + .module config dirs
    # Prompter (Qt-OK boundary) build deps:
    'qt6-base'                  # Core/Gui/Widgets/DBus/Test
    'kcoreaddons'               # KF6::CoreAddons
    'ki18n'                     # KF6::I18n
    # Test-time only — but CONFIGURE-time, not check-time: agent/tests is added
    # unconditionally and does find_package(GTest REQUIRED), so without these the
    # build fails at configure. A clean chroot is the only place that shows: a
    # developer machine and the CI image both have them already.
    'gtest'                     # agent/tests/CMakeLists.txt: find_package(GTest REQUIRED)
    'dbus'                      # dbus-run-session (prompter + agent integration tests)
)
source=(
    "$pkgbase-$pkgver.tar.gz::https://github.com/LibreSCRS/LibreLinux/releases/download/$pkgver/librelinux_$pkgver.orig.tar.gz"
)
# Placeholder — the real sum is filled at tag time with `makepkg -g` (pacman's
# own tool; `updpkgsums` needs pacman-contrib). The 5.0.0 release does not
# exist yet, and the sum is of the tarball the release workflow uploads, so it
# cannot be computed before it. packaging/arch/check-recipe.sh turns a
# remaining SKIP into an error the moment the tag exists; see README.md for the
# local-dogfood build that needs no remote at all.
sha256sums=('SKIP')

build() {
    cd "$srcdir/LibreLinux-$pkgver"
    # Default (system) install layout: systemd user unit dir, D-Bus session
    # service/policy dirs, and the polkit action all resolve to their absolute
    # FHS locations via pkg-config. This is exactly what packaging wants — do
    # NOT pass LIBRELINUX_USER_INSTALL (that is the dogfood-into-$HOME mode).
    # The prompter is ON by default (LIBRELINUX_BUILD_PROMPTER_KDE) so a single
    # build produces both split-package payloads.
    #
    # LIBRELINUX_USE_INSTALLED_AGENT_CORE is not optional here. Its default is
    # OFF, which fetches the agent core and then its CBOR codec over the
    # network. In a network-less chroot that aborts; where it succeeds it is
    # worse, because the package is then built from a development commit rather
    # than from the agent's published tag — the one thing the publication order
    # exists to guarantee. Declaring librescrs-agent-core as a build dependency
    # makes the package manager enforce that order instead of a human
    # remembering it.
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DLIBRELINUX_USE_INSTALLED_AGENT_CORE=ON
    cmake --build build -j4
}

check() {
    cd "$srcdir/LibreLinux-$pkgver"
    # Prompter widget tests need offscreen Qt; the prompter+agent integration
    # tests spin a private bus via dbus-run-session (dbus is a makedepend).
    # Live-card/PIN suites self-skip without a reader + LIBRESCRS_TEST_* env.
    QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure -j4
}

# --- shared staging -----------------------------------------------------------
# One install tree, carved into the two packages by the lists under
# packaging/payload/. The lists are the same ones packaging/payload/check.sh
# compares against a real staged install in both directions, so the recipe and
# the install rules cannot drift apart without the check saying so. They used
# to be spelled out here by hand, and they had drifted: two paths named files
# nothing installs (the package aborted partway through under `set -e`) and two
# message catalogues were never claimed at all.
_stage_once() {
    local stage="$srcdir/stage"
    if [ ! -d "$stage" ]; then
        rm -rf "$stage"
        DESTDIR="$stage" cmake --install build
    fi
}

# _install_payload <payload-name>
#
# Copies everything the named list claims out of the staged tree into $pkgdir,
# preserving the mode rule this recipe has always used: what lives under
# libexec/ or lib/pkcs11/ is executable, the rest is data.
#
# A pattern that expands to nothing is an ERROR, not a satisfied line: a rename
# that stops matching has to fail loudly rather than ship a package quietly
# missing a file. That is exactly how the message catalogues went missing.
_install_payload() {
    local list="$srcdir/LibreLinux-$pkgver/packaging/payload/$1.files"
    local stage="$srcdir/stage"
    local pattern hit rel mode n

    [ -f "$list" ] || { echo "packaging: payload list $list is missing" >&2; return 1; }

    while IFS= read -r pattern || [ -n "$pattern" ]; do
        case "$pattern" in ''|'#'*) continue;; esac
        n=0
        while IFS= read -r hit; do
            [ -f "$hit" ] || continue
            rel=${hit#"$stage"/usr/}
            case "$rel" in
                libexec/*|lib/pkcs11/*) mode=755 ;;
                *)                      mode=644 ;;
            esac
            install -Dm"$mode" "$hit" "$pkgdir/usr/$rel" || return 1
            n=$((n + 1))
        done < <(compgen -G "$stage/usr/$pattern" || true)
        if [ "$n" -eq 0 ]; then
            echo "packaging: '$pattern' in $1.files matches nothing in the staged tree" >&2
            return 1
        fi
    done < "$list"
}

# --- librescrs-agent: headless, Qt-free D-Bus session service -----------------
package_librescrs-agent() {
    pkgdesc="Headless Qt-free D-Bus session agent that owns smart-card access for the LibreSCRS stack"
    depends=(
        'librescrs-middleware>=5.0'
        'sdbus-cpp'
        'systemd-libs'
        'pcsclite'
        'openssl'       # OpenSSL::Crypto — CardFingerprint SHA-256(ATR); the daemon links libcrypto directly
        'p11-kit'       # loads the shipped .module for app auto-discovery + provides `p11-kit server`
    )
    optdepends=(
        'librescrs-pinentry-kde: KDE secure PIN/CAN entry prompter'
        'pcsclite: the pcscd daemon must be running for card access'
        'polkit: client authorization for Sign and trust-config (PolkitAuthorizer)'
    )
    cd "$srcdir/LibreLinux-$pkgver"

    _stage_once
    _install_payload agent

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# --- librescrs-pinentry-kde: KDE secure-input prompter ------------------------
package_librescrs-pinentry-kde() {
    pkgdesc="KDE-styled secure PIN/CAN entry prompter for the LibreSCRS agent"
    depends=(
        'librescrs-agent'
        'librescrs-middleware>=5.0' # links LibreSCRS::Secure (libLibreSCRS_Auth.so)
        'sdbus-cpp'                 # prompter links SDBusCpp::sdbus-c++ -> libsdbus-c++.so.2 directly
        'qt6-base'
        'kcoreaddons'
        'ki18n'
    )
    cd "$srcdir/LibreLinux-$pkgver"

    _stage_once
    _install_payload pinentry-kde

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
