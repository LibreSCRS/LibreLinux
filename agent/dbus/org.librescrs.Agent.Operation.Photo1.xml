<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Typed-result sub-interface for a GetPhoto Operation1. Exported on the
  same object path as the parent Operation1. The Result signal fires
  once, before Operation1.Finished, only when status == Ok.

  Payload: a{sh}
    key           "groupKey:fieldKey" — disambiguates multi-photo cards
                  where two fields share a name (e.g. "personal:photo"
                  vs "supplementary:photo")
    sealed fd     memfd containing the image bytes (FILE_SEAL_SHRINK |
                  FILE_SEAL_GROW | FILE_SEAL_WRITE applied by the agent).
                  Recipient MUST mmap-read and close immediately.

  Late-subscriber recovery — GetResult():
    The Result signal is a one-shot: a client that learns the op path only
    from the GetPhoto() return may subscribe too late (a hot card session —
    the identity read just populated the read cache — finishes the op faster
    than the client's match rules install) and would lose the payload
    forever. GetResult() re-serves the same a{sh} map, each value a FRESHLY
    sealed memfd re-sealed from the retained photo bytes, while the operation
    is still within the cleanup-grace window AND finished Ok. Returns
    org.librescrs.Agent.Error.NoResult once the grace window has elapsed,
    when the operation did not finish Ok, or when a re-seal fails (never a
    half-map). Same recovery contract as Sign1.GetResult. The agent retains
    the raw photo BYTES (not fds) only in RAM and only until the operation is
    evicted (cleanup-grace GC, card removal, owner disconnect) — never
    persisted; same retention policy as the Sign1 artifact.
-->
<node>
  <interface name="org.librescrs.Agent.Operation.Photo1">
    <signal name="Result">
      <arg name="photos" type="a{sh}"/>
    </signal>

    <method name="GetResult">
      <arg name="photos" type="a{sh}" direction="out"/>
    </method>
  </interface>
</node>
