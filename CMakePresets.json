{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "$env{HOME}/.local/librescrs"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release-strict",
      "displayName": "Release + warnings as errors",
      "inherits": "release",
      "cacheVariables": {
        "LIBRELINUX_WERROR": "ON"
      }
    },
    {
      "name": "user",
      "displayName": "Per-user dogfood install ($HOME/.local, XDG units)",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "$env{HOME}/.local",
        "LIBRELINUX_USER_INSTALL": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Debug + gcov)",
      "description": "The configuration ci/coverage-baseline.json was measured under. A coverage number carries its configuration or it is not reproducible, and the gate refuses to compare when the compiler, the gcovr version or the committed test listings moved. Note this build type is Debug: where a CI leg is Release, an assertion-only case can be registered here and not there, so the two discovered sets are close but need not be identical.",
      "binaryDir": "${sourceDir}/build-cov",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O0 -g --coverage -fprofile-update=atomic",
        "CMAKE_C_FLAGS": "-O0 -g --coverage -fprofile-update=atomic",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_SHARED_LINKER_FLAGS": "--coverage"
      },
      "inherits": "base"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 4
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 4
    },
    {
      "name": "release-strict",
      "configurePreset": "release-strict",
      "jobs": 4
    },
    {
      "name": "user",
      "configurePreset": "user",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "LD_LIBRARY_PATH": "$env{HOME}/.local/librescrs/lib"
      }
    }
  ]
}
