<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Typed-result sub-interface for a Credentials1 Operation1 (ManagePin /
  ActivateSigningKey / ListCredentials). Exported on the SAME object path as the
  parent Operation1. Unlike the Sign1/Identity1 results (which fire only on
  status==Ok), the Credentials1 Result fires ONCE for EVERY completed management
  attempt — including invalidPin / blocked, where retries_left is the meaningful
  detail — and always BEFORE Operation1.Finished. The terminal
  Operation1.Finished(status, errorCode) then carries the mapped (status, code)
  for the same outcome; this Result carries the richer payload.

  Result payload:
    result   a{sv}   the uniform outcome payload. Keys:
                       "outcome"       s  one of the outcome tokens (see
                                          Credentials1.xml): unspecified | ok |
                                          userCancelled | missingFields |
                                          invalidPin | blocked | pluginError |
                                          unsupported | keyActivationFailed |
                                          cardRemoved
                       "retries_left"  i  attempts remaining on the presented PIN;
                                          present only when the card reported it
                                          (invalidPin / blocked / ok-with-count)
                       "blocked"       b  the addressed credential is now blocked
                       "pin_activated" b  a transport-PIN bring-up set the holder
                                          PIN (present only when meaningful)
                       "key_activated" b  the signing key was activated (present
                                          only for ActivateSigningKey)
                     A mutation (ManagePin / ActivateSigningKey) always carries at
                     least "outcome" and "blocked".
    records  aa{sv}  the ListCredentials listing — one a{sv} per credential, in
                     listing order. EMPTY for a ManagePin / ActivateSigningKey
                     mutation. Each record a{sv} uses snake_case keys and the
                     closed camelCase value tokens documented on Credentials1.xml:
                       "id"                             s  opaque, stable per card session
                       "label"                          s  human PIN role label
                       "kind"                           s  user|sign|puk|can|unknown
                       "state"                          s  unknown|transport|operational|needsChange|blocked
                       "retries_left"                   i  present when known
                       "retries_max"                    i  present when known
                       "uses_left"                      i  present when known
                       "uses_max"                       i  present when known
                       "unblocks_left"                  i  present when known
                       "min_length"                     i  present when known
                       "max_length"                     i  present when known
                       "can_change"                     b  the PIN can be changed
                       "unblockable"                    b  the PIN can be unblocked
                       "unblock_style"                  s  unknown|resetOnly|setsNewPin|unblockAndChange
                       "activatable"                    b  a transport PIN awaiting bring-up
                       "key_activation_pending"         b  the signing key awaits activation
                       "key_activatable"                b  the signing key can be activated now
                       "recovery"                       s  unknown|holderViaPuk|issuerProcess|none
                       "probe_safe"                     b  status probing cannot lock the card
                       "blocked_guidance_key"           s  localized-text key (present when set)
                       "blocked_guidance_fallback"      s  English fallback (present when set)
                       "key_activation_guidance_key"    s  localized-text key (present when set)
                       "key_activation_guidance_fallback" s English fallback (present when set)
                     Integer and guidance keys are OMITTED when the value is
                     absent (never sent as a sentinel); boolean keys are always
                     present.

  Late-subscriber recovery — GetResult():
    The Result signal is a one-shot; a client that learns the op path only from
    the originating method's return may subscribe too late. GetResult() re-serves
    the EXACT (result, records) payload while the operation is still within the
    cleanup-grace window (it is available for every completed attempt, not only
    Ok, since the payload carries the outcome). Returns
    org.librescrs.Agent.Error.NoResult once the grace window has elapsed. The
    retained payload lives only in agent RAM until the op is evicted (grace GC,
    card removal, owner disconnect) — never persisted; no secret is ever in it.
-->
<node>
  <interface name="org.librescrs.Agent.Operation.Credentials1">
    <signal name="Result">
      <arg name="result"  type="a{sv}"/>
      <arg name="records" type="aa{sv}"/>
    </signal>

    <method name="GetResult">
      <arg name="result"  type="a{sv}"  direction="out"/>
      <arg name="records" type="aa{sv}" direction="out"/>
    </method>
  </interface>
</node>
