<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Agent-owned signing configuration (the single source of truth). Hosted on the
  root object /org/librescrs/Agent alongside Manager1. All settings are
  NON-secret; PIN/CAN/MRZ are never configuration.

  Properties are read-only over org.freedesktop.DBus.Properties; mutation goes
  through SetValue so each change is gated per-key:
    DefaultLevel / DefaultReason / DefaultLocation  -> polkit org.librescrs.agent.configure (default allow)
    TsaUrls / TslSources / CscaSources              -> polkit org.librescrs.agent.configure.trust (auth_self)
    TslCacheDir / AiaCacheDir / PluginDir           -> config-file-only (NOT settable over D-Bus; a
                                                       D-Bus-settable PluginDir is a dlopen code-exec vector)
    LastTsaUrl                                      -> read-only agent-internal state

  CscaSources rides the trust action rather than gaining one of its own: which
  country-signing anchors a passport is checked against is a trust decision of
  the same class as which trusted lists or timestamping authorities are used,
  and a fourth action would split one authorisation regime across two tables.

  ImportCscaMasterList rides that same action, and for a stronger version of the
  same reason: an import does not name a place anchors may come from, it INSTALLS
  the concrete anchors passports will be accepted or refused against. Without
  that gate any process in the user's session could quietly plant a trust store.

  The agent's config file carries three further keys that are NOT properties
  here — CscaCacheDir, Pkcs11IdleTimeoutSecs, Pkcs11MaxLifetimeSecs — all
  config-file-only. SetValue/Reset still know those names and answer
  ReadOnlyConfig; they are simply not readable over this interface.

  SetValue(key, value) rejects with:
    org.librescrs.Agent.Error.UnknownConfigKey    — no such key
    org.librescrs.Agent.Error.ReadOnlyConfig      — file-only / read-only key
    org.librescrs.Agent.Error.NotAuthorized       — polkit denied
    org.librescrs.Agent.Error.InvalidConfigValue  — wrong variant type or invalid value
  Changed(key) fires after any successful mutation (from D-Bus or agent-internal).
-->
<node>
  <interface name="org.librescrs.Agent.Config1">
    <property name="DefaultLevel"    type="s"      access="read"/>
    <property name="TsaUrls"         type="as"     access="read"/>
    <property name="LastTsaUrl"      type="s"      access="read"/>
    <property name="TslSources"      type="a(sbb)" access="read"/>
    <property name="TslCacheDir"     type="s"      access="read"/>
    <property name="AiaCacheDir"     type="s"      access="read"/>
    <!-- (uri, eager) per source. Two fields, not three: a country-signing
         source names anchors, never further sources, so there is no
         list-of-lists pivot flag as TslSources' a(sbb) carries. -->
    <property name="CscaSources"     type="a(sb)"  access="read"/>
    <!-- What the agent currently believes about its country-signing anchors, for
         a client that has to have something to say. An EMPTY dict means nothing
         has been imported; there is no "unconfigured" sentinel to misread.
         Keys, when present:
           anchors      u  anchors held. INCLUDES CSCA link certificates, which
                           are anchors like any other, so this is not a count of
                           self-signed roots.
           issuers      u  distinct issuing countries among those anchors.
           signer       s  lowercase hex SHA-256 over the publisher's
                           SubjectPublicKeyInfo — the fingerprint a person is
                           shown, and the value the next import is pinned to.
           signerPinned b  whether the import ESTABLISHED that publisher's
                           identity — matched the fingerprint, or built a path
                           from the signer to an anchor already held — rather
                           than merely observing it. FALSE after a
                           trust-on-first-import: a surface that renders
                           "authenticity verified" over a false here claims more
                           than was measured.
           acceptedAt   x  seconds since the epoch when the AGENT accepted the
                           list. Under no publisher's control, and not a claim
                           about the list itself.
           signedAt     x  seconds since the epoch when the list says it was
                           SIGNED, from the CMS signingTime signed attribute.
                           ABSENT when the list carries none, which CMS permits;
                           there is no zero sentinel, because a list signed at
                           the epoch and a list with no date must not read alike.
           replayRefusalActive b
                           whether a later import can be refused for rolling the
                           anchors back. ALWAYS present when anything has been
                           imported, because its FALSE is the value worth
                           knowing: it means the accepted list carried no date,
                           so "is this older than what I have" cannot be answered
                           at all. A surface that stays silent leaves a person
                           unable to tell "this is safe" from "this cannot be
                           checked".
           origin       s  where the anchors came from ("import"). -->
    <property name="CscaAnchorState" type="a{sv}"  access="read"/>
    <property name="DefaultReason"   type="s"      access="read"/>
    <property name="DefaultLocation" type="s"      access="read"/>
    <property name="PluginDir"       type="s"      access="read"/>

    <method name="SetValue">
      <arg name="key"   type="s" direction="in"/>
      <arg name="value" type="v" direction="in"/>
    </method>
    <method name="Reset">
      <arg name="key" type="s" direction="in"/>
    </method>

    <!-- Install country-signing trust anchors from a signed ICAO master list.
         Behind polkit org.librescrs.agent.configure.trust (see above).

         An import is a one-shot INPUT, not a source: the file a person picks may
         live in ~/Downloads and be gone tomorrow, so nothing about it is
         remembered as a place to fetch from. The accepted anchors REPLACE the
         cached set, because a master list is a complete statement of what its
         publisher vouches for and merging would keep anchors it has withdrawn.

         masterList is a PLAIN descriptor, not a sealed memfd. Master-list data
         is public: sealing is the agent's vocabulary for secrets, and using it
         here would say something untrue about what is being handed over. It MUST
         be a regular file (or memfd); a pipe or socket is refused, because the
         agent reads it synchronously on the bus thread and an unbounded source
         would stall every other client.

         TRUST. There is nothing to check a first list against — a master list is
         what supplies anchors — so the first accepted list establishes the
         publisher and its fingerprint is reported for a person to recognise.
         Later lists must be that same publisher, or one that descends from an
         authority the PREVIOUS list carried. Anything else is refused and the
         stored anchors are left untouched: a lawful key rotation and an attack
         are indistinguishable from here, so silently accepting one accepts both.

         A rotating publisher's certificate is taken from the SIGNER the incoming
         list's own verification resolved, so a client hands over the file and
         nothing else. It is never taken from the object's certificate bag, which
         is unauthenticated: anybody may drop anybody's certificate in there
         without touching a signature.

         REPLAY. Once a list that carries a signingTime has been accepted, a
         later list must be signed STRICTLY later, and a list carrying no
         signingTime at all is refused. The asymmetry is deliberate. signingTime
         is optional in CMS, so refusing every undated list would turn the
         feature off for a publisher that does not date its lists — but letting
         an undated list replace a dated one would let an attacker STRIP a
         protection this installation already had, and roll the anchors back
         afterwards at will. Nothing is ever refused for a property the ecosystem
         may not provide, and nothing already held is ever given up. Until a
         dated list has been accepted the refusal cannot operate at all, and
         CscaAnchorState says so through replayRefusalActive.

         The reply is the same dict as the CscaAnchorState property above.

         Rejections:
           org.librescrs.Agent.Error.NotAuthorized              polkit denied
           org.librescrs.Agent.Error.RateLimited                caller over budget
           org.librescrs.Agent.Error.InvalidRequest             not a regular file, or
                                                                unreadable
           org.librescrs.Agent.Error.InputTooLarge              past the size bound
           org.librescrs.Agent.Error.NotAMasterList             not a master list at all
           org.librescrs.Agent.Error.EmptyMasterList            signed, and carries no anchor
           org.librescrs.Agent.Error.MalformedMasterList        content unreadable
           org.librescrs.Agent.Error.BadMasterListSignature     signature does not hold
           org.librescrs.Agent.Error.MasterListSignerChanged    a publisher the agent does
                                                                not follow. The message
                                                                carries BOTH fingerprints,
                                                                because deciding between a
                                                                rotation and an attack is a
                                                                person's job, not the
                                                                agent's
           org.librescrs.Agent.Error.MasterListReplayed         authentic, and not newer
                                                                than the list already
                                                                installed — older, dated
                                                                the same, or carrying no
                                                                signing time while the
                                                                installed one does. The
                                                                message carries both dates
           org.librescrs.Agent.Error.AnchorCacheNotWritable     verified, and could not be
                                                                stored — said out loud
                                                                rather than reported as a
                                                                successful import that kept
                                                                nothing -->
    <method name="ImportCscaMasterList">
      <arg name="masterList" type="h"     direction="in"/>
      <arg name="state"      type="a{sv}" direction="out"/>
    </method>

    <signal name="Changed">
      <arg name="key" type="s"/>
    </signal>
  </interface>
</node>
