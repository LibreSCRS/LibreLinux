#, kde-format
msgctxt "@label:textbox PIN entry field"
msgid "PIN:"
msgstr "PIN:"

#: prompter/src/PromptDialog.cpp:69
#, kde-format
msgctxt ""
"@info:status inline error shown above a re-prompt after the card rejected "
"the previously entered CAN/MRZ"
msgid "The value you entered was not accepted. Please try again."
msgstr "Унета вредност није прихваћена. Покушајте поново."

#: prompter/src/PromptDialog.cpp:72
#, kde-format
msgctxt "@info:status generic inline error shown above a credential re-prompt"
msgid "Your previous entry was not accepted. Please try again."
msgstr "Ваш претходни унос није прихваћен. Покушајте поново."

#: prompter/src/PromptDialog.cpp:85
#, kde-format
msgctxt "@info line naming the credential the visible entry form takes"
msgid "Enter the card access number (CAN) printed on the document."
msgstr "Унесите број за приступ картици (CAN) одштампан на документу."

#: prompter/src/PromptDialog.cpp:88
#, kde-format
msgctxt "@info line naming the credential the visible entry form takes"
msgid ""
"Enter the document details exactly as printed in the machine-readable zone."
msgstr "Унесите податке о документу тачно онако како су одштампани у машински читљивој зони."

#: prompter/src/PromptDialog.cpp:102
#, kde-format
msgctxt ""
"@action:button switch the credential prompt back to the card access number "
"form"
msgid "Use card access number (CAN) instead"
msgstr "Пређи на број за приступ картици (CAN)"

#: prompter/src/PromptDialog.cpp:105
#, kde-format
msgctxt ""
"@action:button switch the credential prompt to the passport machine-readable "
"zone form"
msgid "Use passport MRZ instead"
msgstr "Пређи на машински читљиву зону пасоша"

